-- SPARK Proof: Sequence Monotonicity Invariant
-- Theorem: sequence_new = sequence_previous + 1
-- 
-- Proof Strategy:
-- 1. Precondition: writer.sequence is defined and bounded
-- 2. Record creation increments sequence by exactly 1
-- 3. Postcondition: new_sequence = old_sequence + 1
-- 4. Invariant holds: sequence forms strictly increasing chain

pragma Ada_2012;
pragma SPARK_Mode (On);

with Invariants;
use Invariants;

package Sequence_Monotone_Proof is

   --  Lemma: Sequence Increment Property
   --  For any writer state and newly created record:
   --  the new record's sequence equals writer's current sequence + 1
   procedure Lemma_Sequence_Increment
      (Writer : in Writer_Type;
       New_Record : in Record_Type)
   with
      Global => null,
      Pre => (New_Record.Sequence = Writer.Sequence + 1),
      Post => (Invariant_Sequence_Monotone (Writer.Sequence, New_Record.Sequence));

   --  Theorem: Monotone Sequence Chain
   --  For a sequence of append operations, all sequence numbers are strictly
   --  increasing and consecutive (no gaps).
   procedure Theorem_Sequence_Monotone_Chain
      (Writer_Initial : in Writer_Type;
       Record_1 : in Record_Type;
       Record_2 : in Record_Type)
   with
      Global => null,
      Pre => (Invariant_Sequence_Monotone (Writer_Initial.Sequence, Record_1.Sequence)
         and Invariant_Sequence_Monotone (Record_1.Sequence, Record_2.Sequence)),
      Post => (Record_1.Sequence = Writer_Initial.Sequence + 1
         and Record_2.Sequence = Record_1.Sequence + 1);

   --  Corollary: No Sequence Gaps
   --  If all records satisfy sequence_monotone, no gaps exist in the chain.
   procedure Corollary_No_Gaps
      (Seq_1 : in Sequence;
       Seq_2 : in Sequence;
       Seq_3 : in Sequence)
   with
      Global => null,
      Pre => (Invariant_Sequence_Monotone (Seq_1, Seq_2)
         and Invariant_Sequence_Monotone (Seq_2, Seq_3)),
      Post => (Seq_2 = Seq_1 + 1 and Seq_3 = Seq_2 + 1);

end Sequence_Monotone_Proof;
