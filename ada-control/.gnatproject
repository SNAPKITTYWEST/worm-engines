project WORM_Control is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2012",
         "-gnatwa",
         "-gnatwe",
         "-gnatwu",
         "-gnaty3abcdefhijklmnoprstux",
         "-fstack-check",
         "-O2"
      );
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

end WORM_Control;
